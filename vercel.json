{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/model",
      "destination": "/model.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/play",
      "destination": "/index.html"
    },
    {
      "source": "/players",
      "destination": "/players.html"
    },
    {
      "source": "/methods",
      "destination": "/methods.html"
    },
    {
      "source": "/trends",
      "destination": "/trends.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/leaderboard.html"
    },
    {
      "source": "/offline",
      "destination": "/offline.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pitch.jcamd.com"
        }
      ],
      "destination": "https://pitch.dumbmodel.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vector-pitch.vercel.app"
        }
      ],
      "destination": "https://pitch.dumbmodel.com/:path*",
      "permanent": false
    }
  ],
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "."
}
