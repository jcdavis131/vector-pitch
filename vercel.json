{
  "cleanUrls": true,
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ],
  "rewrites": [
    {"source": "/", "destination": "/index.html"}
  ],
  "redirects": [
    {"source": "/play", "destination": "/", "permanent": false},
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "pitch.jcamd.com"}],
      "destination": "https://pitch.dumbmodel.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "vector-pitch.vercel.app"}],
      "destination": "https://pitch.dumbmodel.com/:path*",
      "permanent": false
    }
  ]
}
